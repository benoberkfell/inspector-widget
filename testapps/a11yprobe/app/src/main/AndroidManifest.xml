<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.A11yProbe">

        <!-- Compose launcher: lists every scenario. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.A11yProbe">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Classic-View (XML) screen: exercises the AccessibilityNodeInfo path. -->
        <activity
            android:name=".ViewScenarioActivity"
            android:exported="true"
            android:label="@string/view_screen_title"
            android:theme="@style/Theme.A11yProbe" />

        <!--
          Mixed View/Compose interop screens: a Fragment hosting one of S1..S6
          (RecyclerView / LazyColumn / AndroidView nesting) or a dialog window
          (D1, D2), picked by the "scenario" intent extra.
        -->
        <activity
            android:name=".InteropActivity"
            android:exported="true"
            android:label="Interop"
            android:theme="@style/Theme.A11yProbe" />

        <!-- Bare widgets (no attributes): the host's property-defaults table. -->
        <activity
            android:name=".ViewDefaultsActivity"
            android:exported="true"
            android:label="View defaults"
            android:theme="@style/Theme.A11yProbe" />

        <!--
          TalkBack navigation corpus, classic Views (TbViewActivity.kt):
          the extras scenario=tb_v1..tb_v14 and variant=bad|good. The detail
          screen is V11's second Activity.
        -->
        <activity
            android:name=".TbViewActivity"
            android:exported="true"
            android:label="A11yProbe TalkBack"
            android:theme="@style/Theme.A11yProbe" />

        <activity
            android:name=".TbViewDetailActivity"
            android:exported="false"
            android:label="Folder"
            android:theme="@style/Theme.A11yProbe" />

    </application>

</manifest>
