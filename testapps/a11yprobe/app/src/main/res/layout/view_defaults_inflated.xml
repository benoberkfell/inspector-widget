<?xml version="1.0" encoding="utf-8"?>
<!-- ViewDefaultsActivity's second column: the same bare widgets, inflated, so
     AppCompat/Material substitute their classes. No attribute beyond the size. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/defaults_inflated"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <View android:layout_width="144dp" android:layout_height="48dp" />
    <FrameLayout android:layout_width="144dp" android:layout_height="48dp" />
    <LinearLayout android:layout_width="144dp" android:layout_height="48dp" />
    <ScrollView android:layout_width="144dp" android:layout_height="48dp" />
    <TextView android:layout_width="144dp" android:layout_height="48dp" />
    <ImageView android:layout_width="144dp" android:layout_height="48dp" />
    <Button android:layout_width="144dp" android:layout_height="48dp" />
    <EditText android:layout_width="144dp" android:layout_height="48dp" />
    <CheckBox android:layout_width="144dp" android:layout_height="48dp" />
    <Switch android:layout_width="144dp" android:layout_height="48dp" />
</LinearLayout>
