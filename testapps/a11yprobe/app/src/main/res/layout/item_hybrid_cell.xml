<?xml version="1.0" encoding="utf-8"?>
<!--
  Hybrid RecyclerView row (S3): a classic View cell whose action buttons live in
  a nested ComposeView — a View cell that contains Compose. The Compose half
  carries the row's deliberate defects (see item_view_cell.xml for the list).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hybrid_cell_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="8dp">

    <TextView
        android:id="@+id/hybrid_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textSize="16sp" />

    <CheckBox
        android:id="@+id/hybrid_check"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Done" />

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/hybrid_compose"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />
</LinearLayout>
