<?xml version="1.0" encoding="utf-8"?>
<!--
  D1: the content of ProbeDialogFragment — a floating dialog WINDOW (centered,
  so its origin is not the screen's 0,0) mixing classic Views and a ComposeView.
  BAD: dialog_view_unlabeled (ImageButton) and, inside the ComposeView,
  dialog_compose_unlabeled (IconButton) have no label (a11y.label.missing).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dialog_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="280dp"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/dialog_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Share item"
        android:textSize="20sp"
        android:textStyle="bold" />

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/dialog_compose"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- BAD: unlabeled ImageButton. -->
        <ImageButton
            android:id="@+id/dialog_view_unlabeled"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@android:drawable/ic_menu_send" />

        <!-- GOOD: labeled ImageButton. -->
        <ImageButton
            android:id="@+id/dialog_view_labeled"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Edit"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@android:drawable/ic_menu_edit" />
    </LinearLayout>

    <Button
        android:id="@+id/dialog_close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:text="Close" />
</LinearLayout>
