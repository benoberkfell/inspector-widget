<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      Theme.Material3.DayNight.NoActionBar (from com.google.android.material)
      satisfies BOTH:
        * AppCompatActivity (ViewScenarioActivity) — avoids the
          "You need to use a Theme.AppCompat theme" crash, and
        * the Compose MainActivity (which only needs a valid app theme).
      (testapps.md §5.)
    -->
    <style name="Theme.A11yProbe" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
    </style>

    <!-- Section divider text on the classic-View screen (compact, high contrast). -->
    <style name="SectionTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:textColor">@color/text_good_contrast</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

</resources>
